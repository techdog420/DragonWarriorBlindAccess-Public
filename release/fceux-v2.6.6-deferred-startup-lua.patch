+#ifdef _S9XLUA_H
+static std::string pendingStartupLua;
+
+void fceuWrapperLoadPendingLua(void)
+{
+	if (pendingStartupLua.empty()) return;
+
+	const std::string luaScript = pendingStartupLua;
+	pendingStartupLua.clear();
+	FCEU_WRAPPER_LOCK();
+	FCEU_LoadLuaCode(luaScript.c_str());
+	FCEU_WRAPPER_UNLOCK();
+}
+#endif
