{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \".codex/hooks/session_start_project_context.py\"",
            "timeout": 10,
            "statusMessage": "Loading Dragon Warrior project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \".codex/hooks/pretool_dw_command_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking Dragon Warrior command batching"
          }
        ]
      }
    ]
  }
}
