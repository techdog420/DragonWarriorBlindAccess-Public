{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd); exec python3 -B \"$repo/.codex/hooks/session_start_project_context.py\"'",
            "timeout": 10,
            "statusMessage": "Loading Dragon Warrior project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd); exec python3 -B \"$repo/.codex/hooks/pretool_dw_command_guard.py\"'",
            "timeout": 10,
            "statusMessage": "Checking Dragon Warrior command batching"
          }
        ]
      }
    ]
  }
}
